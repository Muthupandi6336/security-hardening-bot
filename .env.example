# ============================================================
# ShieldAI Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- JWT Secrets (CHANGE THESE!) ---
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES_64
REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_CRYPTO_RANDOM_BYTES_64

# --- CORS Allowed Origins (comma-separated) ---
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Azure Credentials ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# --- GCP Credentials ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Webhook URLs (Optional) ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
